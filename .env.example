# Copy to .env.local and fill in. All env is read through the central config module — never process.env ad hoc.

# Contact form delivery (Resend)
RESEND_API_KEY=
RESEND_EMAIL_TO=
RESEND_EMAIL_FROM=

# AI features (AMA chat + blog TL;DRs) — provider-agnostic.
# Configure ANY ONE of the keys below and AI features work; leave all empty and they degrade gracefully.
# AI_PROVIDER forces a provider when several keys are set: openrouter | openai | anthropic
AI_PROVIDER=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
